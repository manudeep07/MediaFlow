# MediaFlow Environment Configuration

# Server Binding
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Security & Authentication
API_KEY_ENABLED=false
API_KEY=

# Allowed Domains (comma-separated list of trusted source hostnames)
# By default, only trusted public-domain / open-media repositories are allowed.
ALLOWED_DOMAINS=archive.org,commons.wikimedia.org

# Storage & Quotas
STORAGE_DIR=./data/downloads
DB_PATH=./data/mediaflow.db
MAX_FILE_SIZE_MB=1024
MAX_STORAGE_GB=10
FILE_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Job & Process Execution Limits
MAX_PLAYLIST_ITEMS=100
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MINUTES=120

# External Executables (defaults to searching PATH)
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
